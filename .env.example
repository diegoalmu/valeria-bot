# Copia este archivo a .env y llena los valores reales.
# Nunca subas el archivo .env real a GitHub (ya está en .gitignore).
# Ver SEGURIDAD.md para más detalle sobre cómo se usan estas variables.

# Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui

# OpenRouter
OPENROUTER_API_KEY=tu_api_key_aqui

# Google Sheets (OAuth2)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret

# Google Sheets del catálogo
SHEETS_CATALOG_ID=id_del_spreadsheet
SHEETS_CATALOG_NAME=nombre_de_la_hoja
